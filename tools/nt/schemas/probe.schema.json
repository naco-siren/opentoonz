{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "nexttoonz.probe/1",
 "title": "nexttoonz probe (the Python front end fills a part)",
 "type": "object",
 "required": [
  "schema",
  "tool",
  "host",
  "ok",
  "result",
  "warnings"
 ],
 "properties": {
  "schema": {
   "const": "nexttoonz.probe/1"
  },
  "tool": {
   "type": "object",
   "required": [
    "name",
    "version"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "git": {
     "type": [
      "string",
      "null"
     ]
    },
    "build": {
     "type": "object",
     "properties": {
      "program": {
       "type": "string"
      },
      "program_sha256": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "skia": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "default_rasterizer": {
       "enum": [
        "skia",
        "gl"
       ]
      }
     }
    }
   }
  },
  "host": {
   "type": "object",
   "required": [
    "os",
    "arch"
   ],
   "properties": {
    "os": {
     "type": "string"
    },
    "arch": {
     "type": "string"
    }
   }
  },
  "ok": {
   "type": "boolean"
  },
  "result": {
   "type": "object",
   "required": [
    "front_end",
    "stuff",
    "not_available"
   ],
   "properties": {
    "front_end": {
     "enum": [
      "python",
      "native"
     ]
    },
    "python": {
     "type": "object"
    },
    "cpu_count": {
     "type": [
      "integer",
      "null"
     ]
    },
    "stuff": {
     "type": "object",
     "required": [
      "path",
      "exists"
     ]
    },
    "project": {
     "type": "string"
    },
    "local_root": {
     "type": "string"
    },
    "env": {
     "type": "object"
    },
    "c_rand_seed1": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "integer"
     }
    },
    "xvfb_run": {
     "type": [
      "string",
      "null"
     ]
    },
    "not_available": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "warnings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "timing_ms": {
   "type": "object",
   "additionalProperties": {
    "type": "integer"
   }
  }
 }
}
