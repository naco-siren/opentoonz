{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "nexttoonz.gates/1",
 "title": "The machine's verdict per gate (gates.json of a results bundle)",
 "type": "object",
 "required": [
  "schema",
  "gates",
  "ok"
 ],
 "properties": {
  "schema": {
   "const": "nexttoonz.gates/1"
  },
  "ok": {
   "type": "boolean"
  },
  "gates": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "status",
     "summary"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "status": {
      "enum": [
       "pass",
       "fail",
       "known",
       "skipped"
      ]
     },
     "summary": {
      "type": "string"
     },
     "threshold": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
